# =============================================================================
# TFMD BOOKING APP - ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env.local for development
# Copy to .env.staging.local for staging
# Copy to .env.production.local for production

# -----------------------------------------------------------------------------
# REQUIRED: Supabase Configuration
# -----------------------------------------------------------------------------
# Get these from your Supabase project: Project Settings > API
VITE_SUPABASE_URL=https://yourproject.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Service Role Key (for migrations and server-side operations)
# WARNING: This key bypasses RLS. Keep it secret!
SUPABASE_SERVICE_KEY=your_service_key_here

# -----------------------------------------------------------------------------
# OPTIONAL: Supabase Connection Pooler (Recommended for Vercel Serverless)
# -----------------------------------------------------------------------------
# The connection pooler improves performance on serverless platforms like Vercel
# by reusing database connections across function invocations.
# 
# Option 1: Auto-detect (default) - uses pooler when VITE_VERCEL_ENV is set
# Option 2: Explicit pooler URL from Supabase dashboard (Project Settings > Database)
VITE_SUPABASE_POOLER_URL=https://yourproject.supabase.co
VITE_VERCEL_ENV=production  # Set this to enable auto-detect pooler mode

# -----------------------------------------------------------------------------
# REQUIRED: Google OAuth (for Google Calendar integration)
# -----------------------------------------------------------------------------
# 1. Go to https://console.cloud.google.com
# 2. Create a project or select existing
# 3. Enable Google Calendar API
# 4. Create OAuth 2.0 credentials
# 5. Add authorized redirect URIs
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# App URL (used for OAuth redirects)
APP_URL=http://localhost:3000  # Change for staging/production

# -----------------------------------------------------------------------------
# OPTIONAL: AI Services (for chatbot functionality)
# -----------------------------------------------------------------------------
# Primary: Google Gemini API
GEMINI_API_KEY=your_gemini_api_key

# Fallback: OpenRouter API (provides access to various models)
OPENROUTER_API_KEY=your_openrouter_api_key

# -----------------------------------------------------------------------------
# OPTIONAL: Email Service (Resend)
# -----------------------------------------------------------------------------
# Get API key from https://resend.com
RESEND_API_KEY=re_xxxxxxxx
EMAIL_SENDER_NAME=Pause Fascia Movement
EMAIL_SENDER_EMAIL=hello@pausefmd.co.za

# -----------------------------------------------------------------------------
# OPTIONAL: PayFast Payment Gateway (South Africa)
# -----------------------------------------------------------------------------
# Get credentials from https://payfast.co.za
# Sandbox testing: use merchant ID 10000100, key 46f0cd694581a
PAYFAST_MERCHANT_ID=your_merchant_id
PAYFAST_MERCHANT_KEY=your_merchant_key
PAYFAST_PASSPHRASE=your_passphrase
PAYFAST_MODE=sandbox  # Set to 'live' for production
PAYFAST_RETURN_URL=https://yourdomain.com/payment/success
PAYFAST_CANCEL_URL=https://yourdomain.com/payment/cancelled
PAYFAST_NOTIFY_URL=https://yourdomain.com/api/payfast/notify

# -----------------------------------------------------------------------------
# ADMIN CONFIGURATION
# -----------------------------------------------------------------------------
# Admin email for notifications
ADMIN_EMAIL=admin@pausefmd.co.za

# -----------------------------------------------------------------------------
# DEVELOPMENT/TESTING SETTINGS
# -----------------------------------------------------------------------------
# Enable verbose console logging
DEBUG=true

# Mock email sending (useful for testing)
MOCK_EMAILS=false

# Enable test API endpoints
ENABLE_TEST_ENDPOINTS=false

# -----------------------------------------------------------------------------
# TEST USER CONFIGURATION (Development Only)
# -----------------------------------------------------------------------------
# These are only used in development mode for testing
# In production, these should not be set or should be empty
VITE_TEST_USER_EMAIL=
VITE_TEST_USER_NAME=

# -----------------------------------------------------------------------------
# OAUTH ORIGINS
# -----------------------------------------------------------------------------
# Comma-separated allowed origins for Google OAuth
ALLOWED_OAUTH_ORIGINS=https://yourdomain.vercel.app
